# Where the coevta server is listening in development.
#
# `composer dev` in ../server runs `artisan serve --port=8040`, which is the
# default. Copy this file to .env.local and change it if you run the server
# somewhere else.
#
# Development only: the app calls /api/v1/* relatively, so in production it is
# served from the server's own origin and this proxy does not exist.
VITE_SERVER_URL=http://127.0.0.1:8040
