# Where the coevta server is listening in development.
#
# `composer dev` in ../server runs `artisan serve --port=8040`, which is the
# default. Copy this file to .env.local and change it if you run the server
# somewhere else.
#
# Development only: this configures the Vite proxy, which does not exist in a
# build.
VITE_SERVER_URL=http://127.0.0.1:8040

# Where the API lives, baked into the build.
#
# Leave it unset in development: the app then calls /api/v1/* relatively and the
# proxy above answers. Set it for a production build where the API is on a host
# of its own — include the version segment, no trailing slash:
#
#     VITE_API_BASE_URL=https://api.example.com/api/v1
#
# The client authenticates with a bearer token rather than a cookie, so a
# cross-origin API needs CORS on the server but not credentialed requests.
# VITE_API_BASE_URL=
